# Copy this file to .env and fill in your keys
FIRECRAWL_API_KEY=fc-your-firecrawl-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Optional: OpenRouter model to use (any model ID from https://openrouter.ai/models)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: only change this if you use a proxy
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: set to 1 to give the Gradio app a temporary public link (anyone with it can use your keys)
GRADIO_SHARE=0
